<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Form Edit Tugas"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#0A1E5E"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/et_edit_kode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Kode Matkul"
        android:background="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/et_edit_nama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nama Mata Kuliah"
        android:background="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/et_edit_tugas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Deskripsi Tugas"
        android:background="@android:color/white"
        android:padding="12dp"
        android:lines="3"
        android:gravity="top"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/et_edit_deadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Deadline"
        android:background="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_simpan_perubahan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simpan Perubahan"
        android:backgroundTint="#F59E0B"
        android:textColor="#FFFFFF" />

</LinearLayout>