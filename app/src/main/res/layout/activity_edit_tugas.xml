<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Matkul"
        android:textColor="#0F172A"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Perbarui informasi mata kuliah."
        android:textColor="#64748B"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@android:color/white"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KODE MATA KULIAH"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/et_edit_kode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:hint="Kode Matkul"
                android:textColorHint="#CBD5E1"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAMA MATA KULIAH"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/et_edit_nama"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:hint="Nama Matkul"
                android:textColorHint="#CBD5E1"
                android:textColor="#1E293B"
                android:textSize="16sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_simpan_perubahan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Simpan Perubahan"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#10B981"
        app:cornerRadius="12dp"/>
</LinearLayout>